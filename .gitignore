# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/

# Generated exports
exports/stl/*
exports/png/*
exports/dxf/*
exports/csg/*
!exports/stl/.gitkeep
!exports/png/.gitkeep
!exports/dxf/.gitkeep
!exports/csg/.gitkeep

# OpenSCAD customizer sidecars
scad/assemblies/*.json

# Source materials — generated from PDFs, not tracked in git
docs/sources/Drawings/

# Source PDFs
docs/sources/*/*.pdf

# Temporary and logs
*.log
*.tmp
