# DRW-001 Sheet 5 overlay workflow settings.
# Source this file from automation scripts to keep render and composite settings aligned.

# OpenSCAD render mode
MODE="drw001_sheet5_parts_animate"

# Render output geometry
FRAMES=96
IMGSIZE="2340,1364"
QUALITY="preview"
PROJECTION="o"

# Explicit camera string for deterministic CLI export.
# Format:
#   translate_x,y,z,rot_x,y,z,dist
# or:
#   eye_x,y,z,center_x,y,z
#
# Set this after capturing a known-good viewport from the OpenSCAD GUI.
# Leave empty to fall back to --viewall --autocenter.
CAMERA="180.53, 141.97, 0.00, 0.00, 0.00, 0.00, 595.02"

# Optional fixed view flags for PNG export.
# Examples: "axes", "crosshairs", "edges", "scales"
VIEW_OPTIONS=""

# Sheet 5 source drawing page
BACKGROUND="ref/drawings/DRW-001-A-Assembly/a_page05.png"

# Standard workflow directories
GUI_FRAME_SOURCE="scad"
PARTS_PASS_DIR="exports/DRW-001-A-Assembly/sheet5_parts_pass"
COMPOSITE_DIR="exports/DRW-001-A-Assembly/sheet5_composite"
FRAME_GLOB="frame[0-9][0-9][0-9][0-9][0-9].png"

# Current first-pass composite alignment
OFFSET_X=71
OFFSET_Y=195
WHITE_THRESHOLD=245
SCALE=1.0
OPACITY=1.0
